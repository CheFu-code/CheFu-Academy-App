{
    "editor.codeActionsOnSave": {
        "source.fixAll": "always",          // only run "fix all" if you explicitly trigger it
        "source.organizeImports": "always", // organize imports only on explicit save action
        "source.sortMembers": "always",     // sort members (if plugin supports it) only on explicit save
        "source.fixAll.eslint": "always"          // ESLint fixes (including unused imports if plugin is installed)
    },
    "cSpell.words": [
        "appspot",
        "checkcircleo",
        "checkmark",
        "cheforumreal",
        "chefu",
        "chefuacademy",
        "ellipsize",
        "Entypo",
        "firebaseapp",
        "firestore",
        "genai",
        "gradlew",
        "HCCPEMB",
        "IZOYY",
        "JCNs",
        "netinfo",
        "notifee",
        "prebuild",
        "Pressable",
        "rgba",
        "RNFB",
        "scikit",
        "Skus"
    ],
    "eslint.validate": [
        "javascript",
        "javascriptreact",
        "typescript",
        "typescriptreact"
    ]
}
