{
    "extends": "expo/tsconfig.base",
    "compilerOptions": {
        "strict": true,
        "paths": {
            "@/*": ["./*"]
        },
        "jsx": "react-jsx"
    },
    "include": [
        "**/*.ts",
        "**/*.tsx",
        ".expo/types/**/*.ts",
        "expo-env.d.ts",
        "app/index.tsx",
        "app/_layout.tsx",
        "app/auth2.jsx",
        "app/auth.jsx",
        "utils",
        "styles/MyCourses.styles.ts"
    ]
}
